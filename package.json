    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
