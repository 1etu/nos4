{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "Foundation": ["packages/Foundation/src/index.ts"],
      "Device": ["packages/Device/src/index.ts"],
      "SpringBoard": ["packages/SpringBoard/src/index.ts"],
      "CoreGraphics": ["packages/CoreGraphics/src/index.ts"],
      "CoreAnimation": ["packages/CoreAnimation/src/index.ts"],
      "GraphicsServices": ["packages/GraphicsServices/src/index.ts"],
      "SceneKit": ["packages/SceneKit/src/index.ts"],
      "AVFoundation": ["packages/AVFoundation/src/index.ts"],
      "Celestial": ["packages/Celestial/src/index.ts"],
      "CoreLocation": ["packages/CoreLocation/src/index.ts"],
      "CoreTelephony": ["packages/CoreTelephony/src/index.ts"],
      "Preferences": ["packages/Preferences/src/index.ts"],
      "MobileMail": ["packages/MobileMail/src/index.ts"],
      "MobileAddressBook": ["packages/MobileAddressBook/src/index.ts"],
      "MobileMaps": ["packages/MobileMaps/src/index.ts"],
      "UIKit": ["packages/UIKit/src/index.ts"],
      "SpriteKit": ["packages/SpriteKit/src/index.ts"],
      "GameKit": ["packages/GameKit/src/index.ts"],
      "GameFlattyBird": ["packages/GameFlattyBird/src/index.ts"],
      "GameDoom": ["packages/GameDoom/src/index.ts"],
      "MobileSlideShow": ["packages/MobileSlideShow/src/index.ts"],
      "TextInput": ["packages/TextInput/src/index.ts"],
      "MobileCamera": ["packages/MobileCamera/src/index.ts"],
      "MobileWeather": ["packages/MobileWeather/src/index.ts"],
      "MobileSafari": ["packages/MobileSafari/src/index.ts"],
      "MobileiPod": ["packages/MobileiPod/src/index.ts"],
      "MobileStocks": ["packages/MobileStocks/src/index.ts"],
      "MobileNotes": ["packages/MobileNotes/src/index.ts"],
      "MobileCal": ["packages/MobileCal/src/index.ts"],
      "MobileCalculator": ["packages/MobileCalculator/src/index.ts"],
      "MobileTimer": ["packages/MobileTimer/src/index.ts"],
      "MobileCompass": ["packages/MobileCompass/src/index.ts"],
      "MobileGameCenter": ["packages/MobileGameCenter/src/index.ts"],
      "MobileSMS": ["packages/MobileSMS/src/index.ts"],
      "MobilePhone": ["packages/MobilePhone/src/index.ts"],
      "MobileAppStore": ["packages/MobileAppStore/src/index.ts"],
      "MobileStore": ["packages/MobileStore/src/index.ts"],
      "MobileVoiceMemos": ["packages/MobileVoiceMemos/src/index.ts"],
      "NSUserDefaults": ["packages/NSUserDefaults/src/index.ts"]
    }
  }
}
